# ============================================================
# Biến môi trường của Notification Service
# ============================================================
# Phạm vi sử dụng:
# - Sao chép file này thành services/notification-service/.env khi chạy local.
# - Production phải inject riêng các giá trị nhạy cảm qua Secret Manager,
#   Kubernetes Secret, ECS Task Definition hoặc secret của CI/CD.
# - Không đưa secret của service khác vào Notification Service.
# ============================================================

# -----------------------------------------------------------------------------
# 01. Runtime - cấu hình HTTP API và Kafka consumer
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3005
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# 02. MongoDB - cơ sở dữ liệu riêng của Notification Service
# -----------------------------------------------------------------------------
MONGODB_URI=

# -----------------------------------------------------------------------------
# 03. Kafka - nhận event order, payment, user và các event notification
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:29092
KAFKA_GROUP_ID=notification-service

# -----------------------------------------------------------------------------
# 04. Auth Service - tra email người nhận từ userId trong order event
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:3002
INTERNAL_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# 05. Redis - phát tín hiệu realtime sang API Gateway;
#     MongoDB vẫn là nguồn dữ liệu chuẩn của notification.
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# 06. SMTP - gửi email ra bên ngoài
#     Gmail cần App Password; không dùng mật khẩu tài khoản chính.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# -----------------------------------------------------------------------------
# 07. Email branding và liên kết trong nội dung email
# -----------------------------------------------------------------------------
WEB_BASE_URL=http://localhost:5173
EMAIL_LOGO_PATH=assets/email/logo_background_white.png
